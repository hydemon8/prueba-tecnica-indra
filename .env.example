# Copiar a .env y completar. Nunca versionar .env.

# Ruta al dataset COIL-100 (carpeta con obj{N}__{ANG}.png)
COIL_DIR=./coil-100

# Tracking de experimentos (MLflow)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Servicio de visión (Reto 4)
VISION_HOST=127.0.0.1
VISION_PORT=8001
# Artefacto del modelo; su manifiesto (*.manifest.json) debe estar junto a él
VISION_MODEL_PATH=artifacts/linevision-4e39f878-rf.joblib
# Si se define, la API exige la cabecera X-API-Key con este valor
VISION_API_KEY=
# Habilita /admin/fault para simular 5xx y timeouts (solo demo y pruebas de robustez)
VISION_FAULT_INJECTION=false

# LLM del asistente agéntico (Reto 3). Proveedor intercambiable: gemini | azure_openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
