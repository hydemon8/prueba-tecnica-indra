# Copiar a .env y completar. Nunca versionar .env.

# Ruta al dataset COIL-100 (carpeta con obj{N}__{ANG}.png)
COIL_DIR=./coil-100

# Tracking de experimentos (MLflow)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Servicio de visión (Reto 4)
VISION_HOST=127.0.0.1
VISION_PORT=8001
# Artefacto del modelo; su manifiesto (*.manifest.json) debe estar junto a él
VISION_MODEL_PATH=artifacts/linevision-4e39f878-rf.joblib
# Si se define, la API exige la cabecera X-API-Key con este valor
VISION_API_KEY=
# Habilita /admin/fault para simular 5xx y timeouts (solo demo y pruebas de robustez)
VISION_FAULT_INJECTION=false

# Asistente agéntico (Reto 3)
AGENT_HOST=127.0.0.1
AGENT_PORT=8002
# URL del servicio de visión; lineops-up lo arranca si no responde
VISION_URL=http://127.0.0.1:8001
# Si se define, la interfaz pide este código al entrar (recomendado en un despliegue público)
DEMO_ACCESS_CODE=

# LLM. El proveedor va detrás de una interfaz (src/lineops/llm.py); hoy solo está implementado gemini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Peticiones por minuto al LLM (0 = sin límite; 14 para el nivel gratuito de Gemini)
LLM_RPM=0
# Precios por millón de tokens para estimar el costo (supuesto: verificar la tarifa vigente)
LLM_PRICE_IN_PER_MTOK=0.10
LLM_PRICE_OUT_PER_MTOK=0.40
