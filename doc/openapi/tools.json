{
  "tools": [
    {
      "name": "inspect_images",
      "kind": "read",
      "risk": "low",
      "description": "Analiza con el servicio de visión una o varias imágenes cargadas: valida la captura, identifica el producto, estima el ángulo con su incertidumbre, da la decisión del control de seguridad con sus motivos y devuelve las vistas de referencia más parecidas como evidencia.",
      "roles": [
        "maintenance",
        "ml_engineer",
        "operator",
        "plant_manager",
        "quality",
        "supervisor"
      ],
      "approver_roles": [],
      "use_cases": [
        "inspección de imagen"
      ],
      "side_effects": "ninguno",
      "idempotency": "lectura pura: repetirla da el mismo resultado para la misma versión de modelo",
      "errors": [
        "image_not_found",
        "vision_unavailable (reintentable)",
        "vision_rejected"
      ],
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "image_ids": {
            "description": "Identificadores de imágenes cargadas en esta sesión (img-...)",
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Image Ids",
            "type": "array"
          },
          "top_k": {
            "default": 3,
            "description": "Vistas similares a devolver como evidencia",
            "maximum": 5,
            "minimum": 1,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "image_ids"
        ],
        "title": "InspectImagesArgs",
        "type": "object"
      },
      "output_envelope": {
        "ok": "boolean",
        "data": "object si ok",
        "error": "{code, message, retryable} si no ok"
      }
    },
