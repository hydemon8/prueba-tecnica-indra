    {
      "name": "resolve_review_case",
      "kind": "write",
      "risk": "low",
      "description": "Registra la etiqueta (SKU) y el ángulo que una persona ha confirmado para un caso de la cola de revisión. Úsala solo con valores que el usuario haya dado explícitamente en la conversación.",
      "roles": [
        "quality",
        "supervisor"
      ],
      "approver_roles": [],
      "use_cases": [
        "cola de revisión humana"
      ],
      "side_effects": "marca el caso como resuelto con el usuario de la sesión como responsable",
      "idempotency": "repetir con los mismos valores devuelve already_resolved; con otros valores, error conflict",
      "errors": [
        "not_found",
        "conflict",
        "permission_denied"
      ],
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "description": "Caso a resolver, por ejemplo RC-0003",
            "pattern": "^RC-\\d{4}$",
            "title": "Case Id",
            "type": "string"
          },
          "confirmed_object_id": {
            "description": "Producto (SKU) confirmado por la persona",
            "maximum": 100000,
            "minimum": 1,
            "title": "Confirmed Object Id",
            "type": "integer"
          },
          "confirmed_angle_deg": {
            "description": "Ángulo confirmado por la persona, en grados",
            "exclusiveMaximum": 360,
            "minimum": 0,
            "title": "Confirmed Angle Deg",
            "type": "number"
          }
        },
        "required": [
          "case_id",
          "confirmed_object_id",
          "confirmed_angle_deg"
        ],
        "title": "ResolveArgs",
        "type": "object"
      },
